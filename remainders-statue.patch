diff --git a/tests/background.cjs b/tests/background.cjs
new file mode 100644
index 0000000..9a42b48
--- /dev/null
+++ b/tests/background.cjs
@@ -0,0 +1,74 @@
+// Run with: node --test tests/background.cjs
+// Transpile the project's TS/JSX with its existing TypeScript dependency.
+const ts = require('typescript');
+const fs = require('node:fs');
+const path = require('node:path');
+const Module = require('node:module');
+const resolve = Module._resolveFilename;
+Module._resolveFilename = function (name, ...args) {
+  return resolve.call(this, name.startsWith('@/') ? path.join(__dirname, '..', name.slice(2)) : name, ...args);
+};
+for (const ext of ['.ts', '.tsx']) Module._extensions[ext] = (mod, filename) => {
+  const output = ts.transpileModule(fs.readFileSync(filename, 'utf8'), {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.ReactJSX, esModuleInterop: true, target: ts.ScriptTarget.ES2020 },
+  });
+  mod._compile(output.outputText, filename);
+};
+const { test, after } = require('node:test');
+const keepAlive = setInterval(() => {}, 1000);
+after(() => clearInterval(keepAlive));
+const assert = require('node:assert/strict');
+const { ImageResponse } = require('@vercel/og');
+const sharp = require('sharp');
+const LifeView = require('../app/api/wallpaper/life-view-enhanced.tsx').default;
+const YearView = require('../app/api/wallpaper/year-view-enhanced.tsx').default;
+const { DEFAULT_BACKGROUND, normalizeBackground } = require('../lib/background.ts');
+const { computeWallpaperHash } = require('../lib/wallpaper-cache.ts');
+const statue = `data:image/png;base64,${fs.readFileSync(path.join(__dirname, '../public/statue-memento.png')).toString('base64')}`;
+
+test('cache tracks nested background controls and all other nested settings', () => {
+  const hash = config => computeWallpaperHash('test', config, '2026-11-12');
+  const config = { backgroundImage: DEFAULT_BACKGROUND, colors: { past: '#fff' } };
+  for (const [key, value] of Object.entries({ opacity: 0.2, size: 130, positionX: 20, positionY: 20, topInset: 0.4, enabled: false, url: '/other.png' })) {
+    assert.notEqual(hash(config), hash({ ...config, backgroundImage: { ...DEFAULT_BACKGROUND, [key]: value } }), key);
+  }
+  assert.notEqual(hash(config), hash({ ...config, colors: { past: '#aaa' } }));
+  assert.equal(hash(config), hash({ colors: { past: '#fff' }, backgroundImage: { ...DEFAULT_BACKGROUND }, cacheHash: 'ignored' }));
+  assert.notEqual(hash(config), computeWallpaperHash('test', config, '2026-11-13'));
+});
+
+test('legacy backgrounds keep their full-screen layout; invalid settings are bounded', () => {
+  const legacy = normalizeBackground({ url: 'x', type: 'upload', opacity: 0.1 });
+  assert.equal(legacy.topInset, 0);
+  assert.equal(legacy.fit, 'cover');
+  assert.equal(legacy.size, 100);
+  assert.equal(normalizeBackground({ ...DEFAULT_BACKGROUND, size: Infinity }).size, 100);
+  assert.equal(normalizeBackground({ ...DEFAULT_BACKGROUND, opacity: 9 }).opacity, 1);
+});
