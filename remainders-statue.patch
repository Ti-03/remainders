diff --git a/app/api/wallpaper/background-layer.tsx b/app/api/wallpaper/background-layer.tsx
new file mode 100644
index 0000000..40dc5a9
--- /dev/null
+++ b/app/api/wallpaper/background-layer.tsx
@@ -0,0 +1,19 @@
+import type { BackgroundImage } from '@/lib/types';
+import { normalizeBackground } from '@/lib/background';
+
+/** First child of each view: all dots, statistics and text paint above this layer. */
+export default function BackgroundLayer({ image }: { image?: BackgroundImage }) {
+  if (!image?.url || image.enabled === false) return null;
+  const bg = normalizeBackground(image);
+  return (
+    <div style={{ position: 'absolute', left: 0, top: `${bg.topInset! * 100}%`,
+      width: '100%', height: `${(1 - bg.topInset!) * 100}%`, display: 'flex', overflow: 'hidden' }}>
+      {/* eslint-disable-next-line @next/next/no-img-element */}
+      <img src={bg.url} alt="" style={{ position: 'absolute',
+        left: `${bg.positionX}%`, top: `${bg.positionY}%`,
+        width: `${bg.size}%`, height: `${bg.size}%`,
+        transform: `translate(-${bg.positionX}%, -${bg.positionY}%)`,
+        objectFit: bg.fit, objectPosition: `${bg.positionX}% ${bg.positionY}%`, opacity: bg.opacity }} />
+    </div>
+  );
+}
