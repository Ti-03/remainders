+import type { BackgroundImage } from './types';
+
+export const DEFAULT_BACKGROUND: BackgroundImage = {
+  url: '/statue-memento.png', type: 'preset', presetId: 'statue-memento',
+  isFree: true, opacity: 0.7, enabled: true,
+  positionX: 50, positionY: 100, size: 100, topInset: 0.3, fit: 'contain',
+};
+
+function bounded(value: number | undefined, fallback: number, min: number, max: number) {
+  return typeof value === 'number' && Number.isFinite(value)
+    ? Math.min(max, Math.max(min, value)) : fallback;
+}
+
+/** Keep older full-screen backgrounds unchanged; bound all new layout settings. */
+export function normalizeBackground(bg: BackgroundImage): BackgroundImage {
+  return { ...bg, opacity: bounded(bg.opacity, 0.1, 0, 1),
+    positionX: bounded(bg.positionX, 50, 0, 100),
+    positionY: bounded(bg.positionY, 50, 0, 100),
+    size: bounded(bg.size, 100, 25, 200),
+    topInset: bounded(bg.topInset, 0, 0, 0.8),
+    fit: bg.fit === 'contain' ? 'contain' : 'cover',
+  };
+}
