+for (const mode of ['life', 'months', 'continuous', 'calendar']) {
+  test(`${mode}: PNG renders, clock area stays unchanged and statue only changes lower pixels`, async () => {
+    const props = { width: 390, height: 844, colors: { background: '#000000', past: '#FFFFFF', current: '#FF6B35', future: '#404040', text: '#888888' }, birthDate: '2000-01-01', currentDate: new Date('2026-11-12T12:00:00Z'),
+      yearViewLayout: mode === 'months' ? 'months' : 'days', daysLayoutMode: mode,
+      textElements: [{ id: 'test', content: 'MEMENTO MORI', visible: true, x: 50, y: 90, align: 'center' }],
+    };
+    const view = mode === 'life' ? LifeView : YearView;
+    async function render(enabled, opacity = DEFAULT_BACKGROUND.opacity) {
+      const response = new ImageResponse(view({ ...props, backgroundImage: { ...DEFAULT_BACKGROUND, url: statue, enabled, opacity } }), { width: props.width, height: props.height });
+      const png = Buffer.from(await response.arrayBuffer());
+      assert.equal((await sharp(png).metadata()).format, 'png');
+      return png;
+    }
+    const plain = await render(false);
+    const decorated = await render(true);
+    const transparent = await render(true, 0);
+    assert.deepEqual(await sharp(plain).raw().toBuffer(), await sharp(transparent).raw().toBuffer());
+    if (process.env.PREVIEW_DIR) {
+      fs.mkdirSync(process.env.PREVIEW_DIR, { recursive: true });
+      fs.writeFileSync(path.join(process.env.PREVIEW_DIR, `${mode}.png`), decorated);
+    }
+    const crop = (png, top, height) => sharp(png).extract({ left: 0, top, width: props.width, height }).raw().toBuffer();
+    assert.deepEqual(await crop(plain, 0, 250), await crop(decorated, 0, 250));
+    assert.notDeepEqual(await crop(plain, 300, 500), await crop(decorated, 300, 500));
+  });
